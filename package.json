{
  "name": "startboard",
  "version": "0.1.1",
  "description": "Open source start page, published as a Chrome extension and a PWA.",
  "private": true,
  "scripts": {
    "watch": "tailwindcss -i src/input.css -o src/output.css --watch",
    "build:extension": "bun scripts/build-extension.js",
    "build:pwa": "bun scripts/build-pwa.js",
    "build:all": "bun scripts/build-extension.js && bun scripts/build-pwa.js",
    "test": "bun scripts/build-pwa.js && bun scripts/test.js",
    "test:only": "bun scripts/test.js"
  },
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "daisyui": "^5.5.14",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.18"
  },
  "packageManager": "bun@1.3.11"
}
