{
  "name": "startboard",
  "version": "0.1.1",
  "description": "Open source start page, published as a Chrome extension and a PWA.",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o src/output.css",
    "watch": "tailwindcss -i src/input.css -o src/output.css --watch",
    "build:extension": "npm run build:css && node scripts/build-extension.js",
    "build:pwa": "npm run build:css && node scripts/build-pwa.js",
    "build:all": "npm run build:extension && npm run build:pwa"
  },
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "daisyui": "^5.5.14",
    "tailwindcss": "^4.1.18"
  }
}
