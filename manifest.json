{
  "manifest_version": 3,
  "name": "Startboard",
  "version": "0.1.0",
  "description": "Open source start page for Chrome.",
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "icons": {
    "16": "src/img/icon.png",
    "48": "src/img/icon.png",
    "128": "src/img/icon.png"
  },
  "permissions": ["storage"]
}
